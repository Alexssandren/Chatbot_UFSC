# SQLite (criado em backend/ apos migrate)
DATABASE_URL=file:./dev.db

# Porta do backend (deve coincidir com o proxy do Vite em frontend/vite.config.ts)
PORT=3001

UPLOAD_DIR=./uploads
NODE_ENV=development

# Minimo 16 caracteres
SESSION_SECRET=validacert-dev-session-secret-change-me

SESSION_COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Relatorio consolidado PDF
REPORT_COORDINATOR_NAME=Coordenacao do curso TIC
REPORT_COORDINATOR_ROLE=Coordenador do curso de Tecnologias da Informacao e Comunicacao
REPORT_REQUERIMENTO_TITLE=Requerimento de validacao de atividades complementares
